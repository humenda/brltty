# The bindings for a four-way control with a centre. The caller assigns the
# variables up, down, left, right, and centre.

bind \{up} LNUP
bind \{down} LNDN
bind \{left} FWINLT
bind \{right} FWINRT
bind \{centre} HOME

bind Space+\{up} KEY_CURSOR_UP
bind Space+\{down} KEY_CURSOR_DOWN
bind Space+\{left} KEY_CURSOR_LEFT
bind Space+\{right} KEY_CURSOR_RIGHT
bind Space+\{centre} KEY_ENTER

context menu
bind \{up} MENU_PREV_ITEM
bind \{down} MENU_NEXT_ITEM
bind \{left} MENU_PREV_SETTING
bind \{right} MENU_NEXT_SETTING
bind \{centre} PREFMENU

context default
